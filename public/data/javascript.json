    { "q": "Array some() vs every() farqi?", "o": ["Farq yo'q", "some: bittasi true; every: barchasi true", "Teskari", "Faqat bool"], "c": 1, "e": "some kamida bittasi mos, every barchasi mos." },
    { "q": "Optional chaining: user?.address?.city — user null bo'lsa?", "o": ["Xato", "undefined", "null", "\"\""], "c": 1, "e": "?. null/undefined bo'lsa, short-circuit undefined." },
    { "q": "Nullish coalescing (??) — a ?? b:", "o": ["a || b", "Faqat a null/undefined bo'lsa b, aks holda a (falsy 0 emas)", "a + b", "a && b"], "c": 1, "e": "0 ?? 500 → 0; 0 || 500 → 500." },
    { "q": "try { JSON.parse('bad json') } catch (e) {} — e?", "o": ["undefined", "Error obyekti (SyntaxError)", "null", "Xato yo'q"], "c": 1, "e": "JSON.parse noto'g'ri string bo'lsa SyntaxError." }
