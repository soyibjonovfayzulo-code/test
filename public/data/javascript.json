    { "q": "ES6 class vs prototype sintaksis?", "o": ["Umuman yangi tizim", "Prototype ustidan sintaksis shakli (syntactic sugar)", "Interface", "Static klass"], "c": 1, "e": "class prototype ustidan qulay yozuv." },
    { "q": "class Parent; class Child extends Parent — super() chaqirish?", "o": ["Shart emas", "Constructor ichida obboshlikda this ishlatishdan oldin majburiy chaqirish kerak", "Faqat method", "Faqat static"], "c": 1, "e": "extends qilgan klass constructorida super() majbur." },
    { "q": "Event loop JS (brauzer/Node):", "o": ["DOM", "Call stack → web APIs → task queue → execute callback (stack bo'shsa)", "Render loop", "Thread loop"], "c": 1, "e": "Asinxron callbacklar qanday bajarilish mexanizmi." },
