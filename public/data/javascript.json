    { "q": "async function declaration qanday?", "o": ["function* async f()", "async function f()", "await function f()", "promise function"], "c": 1, "e": "async kalit so'z async fn e'lon qiladi." },
    { "q": "async function ichida Promise kutish uchun?", "o": ["wait", "await", "yield", "then()"], "c": 1, "e": "await — promise resolve/ reject bo'lgunicha kutadi." },
