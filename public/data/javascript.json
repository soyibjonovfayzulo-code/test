    { "q": "[1,2,3].length = ?", "o": ["2", "3", "4", "Xato"], "c": 1, "e": ".length property massiv uzunligini ko'rsatadi." },
    { "q": "'JavaScript'[0] qiymati?", "o": ["J", "a", "t", "Xato"], "c": 0, "e": "Indeks 0 dan boshlanadi, 0-harf J." },
    { "q": "alert() funksiyasi brauzerda?", "o": ["Konsolga chiqar", "Dialog box (xabar oynasi) ko'rsatadi", "Fayl och", "Refresh"], "c": 1, "e": "alert() — modal xabar." },
    { "q": "prompt() funksiyasi nima?", "o": ["Faqat xabar", "Foydalanuvchidan input oladi (string)", "Tasdiqlash", "Oynani yopish"], "c": 1, "e": "prompt('Ism?') foydalanuvchidan so'raydi, string qaytaradi." },
    { "q": "Number('123') = ?", "o": ["123", "'123'", "NaN", "Xato"], "c": 0, "e": "Number() string-number aylantiradi: 123." },
    { "q": "parseInt('10') va parseFloat('10.5') farqi?", "o": ["Farq yo'q", "parseInt butun qism, float kasrni ham oladi", "Teskari", "Faqat NaN"], "c": 1, "e": "parseInt → integer, parseFloat → onlik." },
    { "q": "let x = 5; x++; x = ?", "o": ["5", "6", "4", "55"], "c": 1, "e": "++ operatori qiymatni 1 ga oshiradi." },
    { "q": "Math.random() qiymat oralig'i?", "o": ["0..1 (1 kirmaydi)", "0..100", "1..10", "-1..1"], "c": 0, "e": "Math.random() [0, 1) dan 0 ≤ r < 1 gacha float." },
    { "q": "Qanday qilib 1..10 oralig'ida butun son olamiz?", "o": ["random(1,10)", "Math.floor(Math.random()*10)+1", "rand(10)+1", "randomInt"], "c": 1, "e": "floor(r*N)+1 → 1..N oralig'i." },
    { "q": "Template literal (backtick) ichida variable?", "o": ["$x", "${x}", "#{x}", "{x}"], "c": 1, "e": "`Salom ${ism}!` — ${} interpolation." },
