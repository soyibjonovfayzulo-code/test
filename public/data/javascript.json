  "intermediate": [
    { "q": "Arrow function sintaksisi:", "o": ["function () => {}", "() => {}", "=> () {}", "func=>()"], "c": 1, "e": "Arrow fn: (a,b) => a+b." },
    { "q": "[1,2,3].map(x => x*2) natijasi?", "o": ["[1,2,3]", "[2,4,6]", "[1,4,9]", "6"], "c": 1, "e": ".map() yangi array, elementlarni transform." },
    { "q": "[1,2,3,4].filter(x => x>2) = ?", "o": ["[1,2]", "[3,4]", "[2,3,4]", "true"], "c": 1, "e": ".filter() shart true bo'lganlarni qaytaradi." },
    { "q": "[1,2,3,4].reduce((s,n)=>s+n, 0) = ?", "o": ["1", "2", "10", "[10]"], "c": 2, "e": "reduce accumulator: 0+1+2+3+4 = 10." },
    { "q": "Destructuring: const {a} = {a:1, b:2}; a = ?", "o": ["1", "2", "undefined", "{a}"], "c": 0, "e": "Object destructuring: a = 1." },
    { "q": "Destructure array: const [x,y] = [1,2]; y = ?", "o": ["1", "2", "[1,2]", "undefined"], "c": 1, "e": "Array destructuring tartib bo'yicha." },
    { "q": "Spread operator [...[1,2],3] = ?", "o": ["[1,2,3]", "[[1,2],3]", "1,2,3", "Xato"], "c": 0, "e": "... spread iterable ni elementlarga ajratadi." },
    { "q": "REST parameter function fn(...args) — args?", "o": ["Array", "Object", "String", "Number"], "c": 0, "e": "...args — qolgan argumentlar array." },
    { "q": "setTimeout(fn, 1000) — 1000 = ?", "o": ["Sekund", "Millisekund", "Minut", "Qadam"], "c": 1, "e": "Vaqt ms: 1000 ms = 1 soniya." },
    { "q": "let vs const qachon const?", "o": ["Hech qachon const ishlatilmaydi", "Qiymat qayta o'zgartirilmasa (immutable ref) — const afzal", "Faqat number", "Faqat loop"], "c": 1, "e": "Konstanta afzal: o'zgaruvchan bo'lmasa const." },
    { "q": "JSON.stringify({a:1}) = ?", "o": ["{a:1}", "{\"a\":1}", "'{a:1}'", "Object"], "c": 1, "e": "Objectni JSON string ga: '{\"a\":1}'." },
    { "q": "JSON.parse('{\"a\":1}') = ?", "o": ["\"{a:1}\"", "{a:1}", "Object {a:1}", "Xato"], "c": 2, "e": "Stringni JavaScript object/array ga." },
    { "q": "Event listener qo'shish: btn.addEventListener('click', handler) — farqi on click?", "o": ["Farq yo'q", "Bir nechta listenerlar qo'shish, camelCase va boshqalarga imkon", "Faqat HTML", "Faqat JS"], "c": 1, "e": "EventListener zamonaviy, keng imkoniyatli." },
    { "q": "event.preventDefault() nima?", "o": ["Eventni to'xtatish", "Default behavior (a yuborish, form submit) ni bekor qiladi", "Propagation", "Trigger"], "c": 1, "e": "preventDefault — link yoki form odatiy ishini bajarishi yo'q." },
    { "q": "Hoisting JS da?", "o": ["Elevator", "var/function declarationlarni scope boshiga ko'tarish (deklaratsiya)", "Memory leak", "Error"], "c": 1, "e": "var declaration (assignment emas) hoist." },
    { "q": "Closure JS da?", "o": ["Yopilgan", "Ichki funksiya tashqi variable ga kira oladi (unical ham saqlaydi)", "Klass", "Object"], "c": 1, "e": "Closure private state yaratish." },
    { "q": "ES6 module export default function:", "o": ["export fn", "export default fn", "module.exports", "package fn"], "c": 1, "e": "export default ... va import fn from './file.js'." },
    { "q": "Array find vs findIndex farqi?", "o": ["Farq yo'q", "find — element value; findIndex — element indeksi", "Teskari", "Faqat string"], "c": 1, "e": "arr.find(cb) → value, findIndex → index." },
    { "q": "Array includes(): [1,2,3].includes(2) → ?", "o": ["1", "true", "false", "2"], "c": 1, "e": ".includes() boolean qaytaradi, mavjudligini tekshiradi." },
    { "q": "Object.keys({a:1, b:2}) = ?", "o": ["[1,2]", "['a','b']", "{a,b}", "a,b"], "c": 1, "e": "keys kalitlar massivini, values qiymatlar, entries [kalit, qiymat]." },
    { "q": "'Salom'.toLowerCase() va toUpperCase():", "o": ["Xatolik", "'salom', 'SALOM'", "'SALOM', 'salom'", "Hechnarsa"], "c": 1, "e": "Kichik va katta harfga aylantirish." },
    { "q": "String includes(): 'Hello'.includes('ell') — ?", "o": ["false", "true", "1", "2"], "c": 1, "e": ".includes substring bor yo'qligini aniqlaydi." },
