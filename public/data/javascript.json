    { "q": "Promise.race([p1,p2]):", "o": ["Oxirgisi", "Birinchi resolve/reject bo'lgani", "All", "None"], "c": 1, "e": "Race — birinchi tugagani." },
    { "q": "Promise.allSettled([p1,p2]):", "o": ["Barchasi resolve", "Hammasi tugagandan keyin har bir status/value/reason array", "Race", "Ayrim"], "c": 1, "e": "allSettled — status: fulfilled/rejected." },
    { "q": "AbortController & fetch — vazifasi?", "o": ["Cache", "Fetch (network request) ni bekor qilish uchun signal", "Retry", "Upload"], "c": 1, "e": "controller.abort() → fetch reject." },
    { "q": "fetch('/') then(r => ?) — json olish?", "o": ["r.json()", "r.body", "JSON.parse(r)", "r.text"], "c": 0, "e": "r.json() — body Promise sifatida json parse." },
    { "q": "localStorage vs sessionStorage farqi?", "o": ["Farq yo'q", "localStorage doimiy; sessionStorage tab yopilganda o'chadi", "Teskari", "Faqat file"], "c": 1, "e": "Xotira davomiyligi farqi." },
    { "q": "Curried funksiya? f(a,b,c) → f(a)(b)(c) —:", "o": ["Rekursiya", "Qisman argumentlarni qabul qiladigan (hammasi qabul qilinguncha) funksiyalar zanjiri", "Pipe", "Chain"], "c": 1, "e": "Currying — arity-1 funksiyalar ketma-ketligi." },
    { "q": "Strict mode: 'use strict'; ta'siri?", "o": ["Tezroq", "Global variable yaratishni taqiqlash, this = undefined (fn da) va boshqa xavfsizliklar", "Slow", "Debug"], "c": 1, "e": "'use strict' xatolarni tez topishga yordam beradi." },
    { "q": "Observer pattern JSda (ResizeObserver, MutationObserver):", "o": ["Pub/sub", "State/DOM o'zgarishlarni kuzatuvchi (watch) patternlar", "Scheduler", "Worker"], "c": 1, "e": "Observer object turli o'zgarishlarni observe qiladi." },
    { "q": "Web Worker nima?", "o": ["Service", "Background threadda ish (main threadni bloklamasdan)", "UI worker", "Job worker"], "c": 1, "e": "CPU og'ir ishlar uchun Worker." },
    { "q": "IIFE pattern: (function(){ ... })(); — maqsadi?", "o": ["IIFE: hozir run", "Global scope'ni ifloslamasdan, local variable yaratish", "Named fn", "Recursion"], "c": 1, "e": "Hozir bajariladigan ifodalangan funksiya." },
    { "q": "Object.freeze() vs Object.seal():", "o": ["Farq yo'q", "Freeze: o'qishgina; Seal: qo'shish/o'chirish taqiqlanadi, lekin mavjud property o'zgartirish mumkin", "Deep", "Shallow"], "c": 1, "e": "Freeze strict immutability (shallow)." },
    { "q": "V8 enginening JIT (just-in-time) compiler:", "o": ["Interpreter", "Tezyoq ishlatish uchun native code compile qiladi (interpretation + optimization)", "Lexer", "Linker"], "c": 1, "e": "V8 SpiderMonkey singari hybrid interpreter+compiler." },
    { "q": "Shadow DOM?", "o": ["Shadow", "Encapsulated DOM (component ichidagi isolated CSS/DOM)", "Hidden", "Real DOM"], "c": 1, "e": "Web Components uchun DOM izolyatsiyasi." },
    { "q": "Trampoline nima uchun JS recursion?", "o": ["Jumper", "Stack overflow ni oldini olish uchun tail recursion iterative yordamchi", "Call stack", "Heap"], "c": 1, "e": "JS TCO yo'q → trampoline yordamida." }
