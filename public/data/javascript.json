    { "q": "Array qanday yaratiladi?", "o": ["{}", "[]", "()", "new Array() ikkalasi ham"], "c": 3, "e": "[1,2,3] literal yoki new Array(1,2,3) (literal afzal)." },
    { "q": "const massivni elementini o'zgartirsa bo'ladimi?", "o": ["Yo'q, const hech narsa o'zgarmaydi", "Ha, elementni o'zgartirish mumkin, faqat qayta assignment mumkin emas", "Faqat number", "Faqat string"], "c": 1, "e": "const o'zgaruvchi — reference, arr.push()/arr[0]=... mumkin, arr = yangisi emas." },
