    { "q": "Quyidagi truthy value qaysi?", "o": ["0", "\"\"", "\"0\"", "null"], "c": 2, "e": "Falsy: 0, '', null, undefined, NaN, false. Truthy: qolganlari, shu jumladan '0'." },
    { "q": "!true qiymati?", "o": ["true", "false", "1", "0"], "c": 1, "e": "! (mantiqiy inkor) true ni false ga aylantiradi." },
