  "advanced": [
    { "q": "this kalit so'zi regular fn arrow farqi?", "o": ["Farq yo'q", "Arrow fn lexical this oladi; regular call qilinishiga qarab (new, bind, obj.fn)", "Global", "Undefined"], "c": 1, "e": "Arrow — this qaysi joyda yaratilganiga bog'liq, regular → call context." },
