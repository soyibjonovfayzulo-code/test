    { "q": "return statementsiz funksiya qaytaradigan narsa?", "o": ["0", "null", "undefined", "NaN"], "c": 2, "e": "Return bo'lmasa, funksiya default undefined qaytaradi." },
    { "q": "Ternary operator: x > 5 ? 'katta' : 'kichik' — x=3 bo'lsa?", "o": ["katta", "kichik", "3", "xato"], "c": 1, "e": "shart ? true : false; 3<5 → 'kichik'." },
    { "q": "DOM hujjatga kirish?", "o": ["window", "document", "document.querySelector()", "Barchasi"], "c": 3, "e": "document — DOM root; window — global scope." },
    { "q": "Elementni id orqali topish:", "o": ["document.getById(\"x\")", "document.getElementById(\"x\")", "document.find(\"#x\")", "#x"], "c": 1, "e": "getElementById to'g'ri." },
    { "q": "CSS class qo'shish uchun element:", "o": ["el.class = \"new\"", "el.classList.add(\"new\")", "el.addClass", "el.className = \"new\" ikkalasi ham"], "c": 3, "e": "classList.add osonroq va xavfsiz, className bilan to'liq almashtirish." }
