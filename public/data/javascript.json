    { "q": "console.log() asosiy vazifasi?", "o": ["Ekranga chiqaradi", "Brauzer konsolga chiqaradi", "Faylga yozadi", "Serverga yuboradi"], "c": 1, "e": "console.log() brauzer DevTools yoki Node konsoliga chiqaradi." },
    { "q": "JS string qanday belgida yoziladi?", "o": ["Faqat \"\"", "Faqat ''", "Faqat `` (backtick)", "Uchtasi ham ishlaydi"], "c": 3, "e": "JS string: 'single', \"double\", `backtick` — hammasi." },
    { "q": "typeof 42 qaytaradigan narsa?", "o": ["\"int\"", "\"number\"", "\"integer\"", "\"digit\""], "c": 1, "e": "typeof butun va onlik son — 'number'." },
