    { "q": "Proxy obyekt nima?", "o": ["Server proxy", "Object wrapper — get/set va boshqa operatsiyalarni intersept qiluvchi", "DOM proxy", "URL"], "c": 1, "e": "new Proxy(target, handler) traps (get, set, has, ...)." },
    { "q": "Reflect API bilan ishlash?", "o": ["Reflection", "Object operatsiyalarini funksiya ko'rinishida (Reflect.get, set, ...)", "DOM", "Promise"], "c": 1, "e": "Proxy handlerlarda afzal Reflect.* operatsiyalar." },
    { "q": "WeakMap vs Map farqi?", "o": ["Farq yo'q", "WeakMap — key-only object, GC oladi (enumerable emas, no size)", "String key", "Faqat number"], "c": 1, "e": "WeakMap key — objects, bo'shatish uchun Memory safe." },
    { "q": "Set vs Map — Set asosiy?", "o": ["Key-value", "Unique value (unikal qiymatlar)", "Sorted list", "Queue"], "c": 1, "e": "new Set([1,2,2,3]) → {1,2,3}." },
