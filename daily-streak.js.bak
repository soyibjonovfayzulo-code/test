/* ============================================================
   ITTest — UNIVERSAL DAILY ENGINE + MOBILE STREAK & FREEZE
   Duolingo ruhida, ITTest original dizayni bilan yaratilgan
   universal kunlik o'rganish, streak va streak freeze tizimi.
   ============================================================ */

(function () {
  'use strict';

  var DAILY_STORE_KEY = 'daily_state_v1';
  var DEFAULT_GOAL_MINUTES = 15;
  var DEFAULT_FREEZES = 2;

  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.from((root || document).querySelectorAll(sel)); }

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function isMobile() {
    try {
      if (typeof window !== 'undefined' && window.Capacitor) return true;
      if (typeof window !== 'undefined' && typeof window.innerWidth === 'number' && window.innerWidth <= 768) return true;
    } catch (e) { /* noop */ }
    return false;
  }

  function reducedMotion() {
    try {
      return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    } catch (e) { return false; }
  }

  /* ---------- BLUE FIRE (ITTest Moviy Olov) SVG HELPER ---------- */
  function blueFireSVG(size) {
    var s = size || 44;
    return (
      '<span class="ds-blue-flame" style="width:' + s + 'px;height:' + s + 'px;" aria-hidden="true">' +
        '<svg viewBox="0 0 40 48" class="ds-blue-fire-svg">' +
          '<defs>' +
            '<linearGradient id="dsBlueFireGrad" x1="0%" y1="100%" x2="0%" y2="0%">' +
              '<stop offset="0%" stop-color="#1d4ed8" />' +
              '<stop offset="45%" stop-color="#2563eb" />' +
              '<stop offset="75%" stop-color="#38bdf8" />' +
              '<stop offset="100%" stop-color="#e0f2fe" />' +
            '</linearGradient>' +
            '<filter id="dsBlueGlow" x="-30%" y="-30%" width="160%" height="160%">' +
              '<feGaussianBlur stdDeviation="2.5" result="blur" />' +
              '<feComposite in="SourceGraphic" in2="blur" operator="over" />' +
            '</filter>' +
          '</defs>' +
          '<path class="ds-fire-glow" fill="url(#dsBlueFireGrad)" filter="url(#dsBlueGlow)" d="M20 2 C23 9, 31 15, 34 23 C39 31, 35 42, 24 46 C32 40, 31 30, 26 25 C24 33, 19 36, 17 44 C8 39, 4 30, 8 20 C10 15, 16 11, 17 6 C17 12, 19 13, 20 2 Z" />' +
          '<path class="ds-fire-outer" fill="url(#dsBlueFireGrad)" d="M20 2 C23 9, 31 15, 34 23 C39 31, 35 42, 24 46 C32 40, 31 30, 26 25 C24 33, 19 36, 17 44 C8 39, 4 30, 8 20 C10 15, 16 11, 17 6 C17 12, 19 13, 20 2 Z" />' +
          '<path class="ds-fire-inner" fill="#ffffff" opacity="0.9" d="M20 18 C22 23, 27 27, 26 34 C25 38, 22 42, 19 43 C22 39, 21 34, 18 31 C17 35, 14 37, 14 41 C11 38, 10 32, 12 28 C13 25, 17 23, 18 21 C18 24, 19 25, 20 18 Z" />' +
        '</svg>' +
      '</span>'
    );
  }

  /* ---------- SANALAR BILAN ISHLASH (Real local calendar date) ---------- */
  function dayKey(ts) {
    var d = ts ? new Date(ts) : new Date();
    return d.getFullYear() + '-' +
      String(d.getMonth() + 1).padStart(2, '0') + '-' +
      String(d.getDate()).padStart(2, '0');
  }

  function parseDayKey(dk) {
    if (!dk || typeof dk !== 'string') return new Date();
    var parts = dk.split('-').map(Number);
    return new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0, 0);
  }

  function daysDiff(d1Str, d2Str) {
    var d1 = parseDayKey(d1Str);
    var d2 = parseDayKey(d2Str);
    return Math.round((d2.getTime() - d1.getTime()) / 86400000);
  }

  function currentUser() {
    try {
      return (window.__itGetCurrentUser && typeof window.__itGetCurrentUser === 'function')
        ? window.__itGetCurrentUser()
        : null;
    } catch (e) { return null; }
  }

  function userKey() {
    var u = currentUser();
    return String((u && (u.username || u.email || u.id)) || 'guest').toLowerCase();
  }

  /* ---------- LOCALSTORAGE STATE ---------- */
  function getFullStore() {
    var k = DAILY_STORE_KEY + '::' + userKey();
    var raw = null;
    try { raw = localStorage.getItem(k); } catch (e) { raw = null; }
    var store = null;
    try { store = raw ? JSON.parse(raw) : null; } catch (e) { store = null; }
    if (!store || typeof store !== 'object') store = {};
    if (!store.history || typeof store.history !== 'object') store.history = {};
    if (!store.settings || typeof store.settings !== 'object') {
      store.settings = {
        dailyGoalMinutes: DEFAULT_GOAL_MINUTES,
        notificationEnabled: false,
        permissionAsked: false,
        onboardingIntroCompleted: false
      };
    }
    return store;
  }

  function saveFullStore(store) {
    var k = DAILY_STORE_KEY + '::' + userKey();
    try { localStorage.setItem(k, JSON.stringify(store)); } catch (e) { /* noop */ }
  }

  function getDayRecord(store, dateStr) {
    var dk = dateStr || dayKey();
    if (!store.history[dk]) {
      store.history[dk] = {
        date: dk,
        learningMinutes: 0,
        lessonsCompleted: 0,
        testsCompleted: 0,
        xpEarned: 0,
        goalMinutes: (store.settings && store.settings.dailyGoalMinutes) || DEFAULT_GOAL_MINUTES,
        goalCompleted: false,
        streakEligible: false,
        freezeUsed: false,
        completedLessonIds: [],
        completedTestIds: [],
        celebrationShown: false
      };
    }
    var rec = store.history[dk];
    if (!Array.isArray(rec.completedLessonIds)) rec.completedLessonIds = [];
    if (!Array.isArray(rec.completedTestIds)) rec.completedTestIds = [];
    return rec;
  }

  /* ---------- STREAK VA FREEZE EVALUATION ---------- */
  function ensureUserFreezes(u) {
    if (!u) return DEFAULT_FREEZES;
    if (u.freezes === undefined || u.freezes === null) {
      u.freezes = DEFAULT_FREEZES;
    }
    return u.freezes;
  }

  function syncStreakAndFreezes(u) {
    if (!u) return;
    ensureUserFreezes(u);
    var today = dayKey();
    var lastActive = u.lastActiveDay;
    var streak = u.streak || 0;

    if (!lastActive || streak <= 0) {
      return;
    }

    var diff = daysDiff(lastActive, today);
    if (diff <= 1) {
      // 0: bugun, 1: kecha -> streak xavfsiz
      return;
    }

    // diff >= 2: o'rtadagi kunlar qoldirilgan (missedDays = diff - 1)
    var missedCount = diff - 1;
    var store = getFullStore();
    var lastActiveTs = parseDayKey(lastActive).getTime();

    for (var i = 1; i <= missedCount; i++) {
      var missedDk = dayKey(lastActiveTs + i * 86400000);
      var rec = getDayRecord(store, missedDk);

      if (u.freezes > 0 && streak > 0) {
        // Freeze ishlatiladi
        u.freezes -= 1;
        rec.freezeUsed = true;
        rec.protected = true;
      } else {
        // Freeze yo'q -> streak 0 ga reset bo'ladi
        streak = 0;
        u.streak = 0;
        rec.freezeUsed = false;
        rec.missed = true;
      }
    }

    saveFullStore(store);
    try {
      if (typeof window.saveUsersAndCurrent === 'function') {
        window.saveUsersAndCurrent();
      }
    } catch (e) { /* noop */ }
  }

  function recordActivity(type, info) {
    var u = currentUser();
    var store = getFullStore();
    var today = dayKey();
    syncStreakAndFreezes(u);

    var rec = getDayRecord(store, today);
    if (!Array.isArray(rec.completedLessonIds)) rec.completedLessonIds = [];
    if (!Array.isArray(rec.completedTestIds)) rec.completedTestIds = [];
    var xp = Number((info && info.xp) || 0);

    if (type === 'lesson') {
      var lid = info && info.lessonId;
      if (lid && rec.completedLessonIds.indexOf(lid) === -1) {
        rec.completedLessonIds.push(lid);
        rec.lessonsCompleted = (rec.lessonsCompleted || 0) + 1;
        rec.xpEarned = (rec.xpEarned || 0) + xp;
      }
    } else if (type === 'test') {
      var tid = info && info.testId;
      if (tid && rec.completedTestIds.indexOf(tid) === -1) {
        rec.completedTestIds.push(tid);
        rec.testsCompleted = (rec.testsCompleted || 0) + 1;
        rec.xpEarned = (rec.xpEarned || 0) + xp;
      }
    }

    // Kunlik muvaffaqiyat (streak eligible)
    var wasEligible = rec.streakEligible;
    if (rec.lessonsCompleted > 0 || rec.testsCompleted > 0 || rec.learningMinutes >= rec.goalMinutes) {
      rec.streakEligible = true;
      rec.goalCompleted = true;
    }

    if (u && rec.streakEligible && !wasEligible) {
      if (u.lastActiveDay === today) {
        // allaqachon bugun hisoblangan
      } else if (!u.lastActiveDay || u.streak === 0) {
        u.streak = 1;
        u.lastActiveDay = today;
      } else {
        u.streak = (u.streak || 0) + 1;
        u.lastActiveDay = today;
      }
    }

    saveFullStore(store);
    try {
      if (typeof window.saveUsersAndCurrent === 'function') {
        window.saveUsersAndCurrent();
      }
    } catch (e) { /* noop */ }

    return rec;
  }

  /* ---------- LEARNING TIME TRACKER ---------- */
  var session = {
    active: false,
    startTime: 0,
    accumulatedSec: 0,
    lastTick: 0,
    courseId: null,
    lessonId: null,
    interval: null
  };

  function startLearningSession(courseId, lessonId) {
    endLearningSession();
    session.active = true;
    session.startTime = Date.now();
    session.lastTick = Date.now();
    session.accumulatedSec = 0;
    session.courseId = courseId;
    session.lessonId = lessonId;

    if (!session.interval) {
      session.interval = setInterval(function () {
        if (!session.active || document.hidden) return;
        var now = Date.now();
        var delta = (now - session.lastTick) / 1000;
        session.lastTick = now;
        if (delta > 0 && delta < 10) {
          session.accumulatedSec += delta;
        }
      }, 1000);
    }
  }

  function pauseLearningSession() {
    if (!session.active) return;
    var now = Date.now();
    var delta = (now - session.lastTick) / 1000;
    session.lastTick = now;
    if (delta > 0 && delta < 10) {
      session.accumulatedSec += delta;
    }
  }

  function resumeLearningSession() {
    if (!session.active) return;
    session.lastTick = Date.now();
  }

  function endLearningSession() {
    if (!session.active) return;
    pauseLearningSession();
    session.active = false;
    if (session.interval) {
      clearInterval(session.interval);
      session.interval = null;
    }

    var minutes = Math.max(1, Math.round(session.accumulatedSec / 60));
    var store = getFullStore();
    var today = dayKey();
    var rec = getDayRecord(store, today);
    rec.learningMinutes = (rec.learningMinutes || 0) + minutes;
    if (rec.learningMinutes >= rec.goalMinutes) {
      rec.goalCompleted = true;
      rec.streakEligible = true;
    }
    saveFullStore(store);
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) pauseLearningSession();
    else resumeLearningSession();
  });

  window.addEventListener('beforeunload', function () {
    endLearningSession();
  });

  /* ---------- HAFTALIK KO'RINISH (Du..Ya) ---------- */
  var WEEK_LABELS = ['Du', 'Se', 'Ch', 'Pa', 'Ju', 'Sh', 'Ya'];

  function getWeekDaysData(u) {
    var today = new Date();
    today.setHours(12, 0, 0, 0);
    var currentMonday = new Date(today);
    currentMonday.setDate(currentMonday.getDate() - ((currentMonday.getDay() + 6) % 7));

    var store = getFullStore();
    var todayDk = dayKey(today.getTime());
    var days = [];

    for (var d = 0; d < 7; d++) {
      var ts = currentMonday.getTime() + d * 86400000;
      var dk = dayKey(ts);
      var rec = store.history[dk] || null;
      var isCurrentToday = (dk === todayDk);
      var isPast = ts < today.getTime() && !isCurrentToday;
      var isFuture = ts > today.getTime() && !isCurrentToday;

      var status = 'empty';
      if (rec && rec.freezeUsed) {
        status = 'freeze';
      } else if (rec && (rec.streakEligible || rec.lessonsCompleted > 0 || rec.testsCompleted > 0)) {
        status = 'completed';
      } else if (isCurrentToday) {
        status = 'today';
      } else if (isPast) {
        status = 'missed';
      } else if (isFuture) {
        status = 'future';
      }

      days.push({
        dayIndex: d,
        label: WEEK_LABELS[d],
        dateKey: dk,
        isToday: isCurrentToday,
        isPast: isPast,
        isFuture: isFuture,
        status: status,
        freezeUsed: !!(rec && rec.freezeUsed),
        completed: status === 'completed',
        rec: rec
      });
    }
    return days;
  }

  /* ============================================================
     MOBILE UI SCREENS
     Flow:
     1. FIRST-TIME DAILY INTRO
     2. PERMISSION REQUEST (agar berilmagan bo'lsa)
     3. DAILY MAIN SCREEN
     4. FIRST LESSON
     ============================================================ */

  /* 1. FIRST-TIME MOBILE DAILY INTRO SCREEN */
  function showMobileIntro(options) {
    if (!isMobile()) {
      if (options && typeof options.onDone === 'function') options.onDone();
      return;
    }

    var store = getFullStore();
    var u = currentUser();
    syncStreakAndFreezes(u);
    var streak = Math.max(1, (u && u.streak) || 1);
    var week = getWeekDaysData(u);

    var existing = document.getElementById('dsIntroModal');
    if (existing) existing.remove();

    var weekHtml = week.map(function (w) {
      var icon = '○';
      var cls = 'ds-week-day';
      if (w.status === 'completed') { icon = '✓'; cls += ' ds-day-done'; }
      else if (w.status === 'freeze') { icon = '🧊'; cls += ' ds-day-freeze'; }
      else if (w.isToday) { icon = '•'; cls += ' ds-day-today'; }
      else if (w.status === 'future') { cls += ' ds-day-future'; }
      return '<div class="' + cls + '"><span class="ds-day-lbl">' + w.label + '</span><span class="ds-day-dot">' + icon + '</span></div>';
    }).join('');

    var robotHtml = '';
    try {
      if (window.ITMascot && typeof window.ITMascot.html === 'function') {
        robotHtml = window.ITMascot.html('idle', 'mascot--md');
      }
    } catch (e) { /* noop */ }

    var modal = document.createElement('div');
    modal.id = 'dsIntroModal';
    modal.className = 'ds-screen-overlay';
    modal.innerHTML =
      '<div class="ds-screen-card ds-anim-in">' +
        '<div class="ds-screen-badge"><span aria-hidden="true">🎯</span> KUNLIK O‘QUV REJIMI</div>' +
        '<h2 class="ds-screen-title">Har kuni ozgina o‘rganing — bilimingiz kuchayadi.</h2>' +
        '<div class="ds-mascot-box">' + (robotHtml || '<div class="ds-mascot-fallback">🤖</div>') + '</div>' +
        '<div class="ds-streak-counter">' +
          blueFireSVG(38) +
          '<span class="ds-streak-number">' + streak + '</span>' +
          '<span class="ds-streak-unit">kunlik streak</span>' +
        '</div>' +
        '<div class="ds-week-row" aria-label="Haftalik streak">' + weekHtml + '</div>' +
        '<div class="ds-screen-actions">' +
          '<button type="button" class="btn btn-primary ds-btn-lg" id="dsIntroNextBtn">🚀 Davom etish →</button>' +
        '</div>' +
      '</div>';

    document.body.appendChild(modal);

    var btn = modal.querySelector('#dsIntroNextBtn');
    if (btn) {
      btn.addEventListener('click', function () {
        modal.classList.add('ds-anim-out');
        setTimeout(function () {
          modal.remove();
          // Permission tekshiruvi: agar so'ralmagan bo'lsa permission, aks holda Daily Main
          if (!store.settings.permissionAsked) {
            showMobilePermission(options);
          } else {
            showMobileDailyMain(options);
          }
        }, reducedMotion() ? 10 : 320);
      });
    }
  }

  /* 2. NOTIFICATION PERMISSION SCREEN (Mobile) */
  function showMobilePermission(options) {
    if (!isMobile()) {
      if (options && typeof options.onDone === 'function') options.onDone();
      return;
    }

    var store = getFullStore();
    if (store.settings.permissionAsked) {
      showMobileDailyMain(options);
      return;
    }

    var existing = document.getElementById('dsPermModal');
    if (existing) existing.remove();

    var modal = document.createElement('div');
    modal.id = 'dsPermModal';
    modal.className = 'ds-screen-overlay';
    modal.innerHTML =
      '<div class="ds-screen-card ds-anim-in">' +
        '<div class="ds-screen-badge"><span aria-hidden="true">🔔</span> ESLATMALAR</div>' +
        '<div class="ds-perm-icon">🔔</div>' +
        '<h2 class="ds-screen-title">Har kuni eslatib turaymi?</h2>' +
        '<p class="ds-screen-sub">Kunlik 15 daqiqa dars va streakni yo‘qotmaslik uchun qisqa eslatma yuboramiz.</p>' +
        '<div class="ds-screen-actions">' +
          '<button type="button" class="btn btn-primary ds-btn-lg" id="dsPermAllowBtn">🔔 Ruxsat berish</button>' +
          '<button type="button" class="btn btn-ghost ds-btn-lg" id="dsPermDenyBtn">Keyinroq</button>' +
        '</div>' +
      '</div>';

    document.body.appendChild(modal);

    function proceed(allowed) {
      store.settings.permissionAsked = true;
      store.settings.notificationEnabled = !!allowed;
      saveFullStore(store);

      if (allowed && typeof window.Notification !== 'undefined' && Notification.requestPermission) {
        try { Notification.requestPermission(); } catch (e) { /* noop */ }
      }

      modal.classList.add('ds-anim-out');
      setTimeout(function () {
        modal.remove();
        showMobileDailyMain(options);
      }, reducedMotion() ? 10 : 320);
    }

    var allowBtn = modal.querySelector('#dsPermAllowBtn');
    var denyBtn = modal.querySelector('#dsPermDenyBtn');
    if (allowBtn) allowBtn.addEventListener('click', function () { proceed(true); });
    if (denyBtn) denyBtn.addEventListener('click', function () { proceed(false); });
  }

  /* 3. DAILY / STREAK MAIN SCREEN (Mobile) */
  function showMobileDailyMain(options) {
    if (!isMobile()) {
      if (options && typeof options.onDone === 'function') options.onDone();
      return;
    }

    var store = getFullStore();
    var u = currentUser();
    syncStreakAndFreezes(u);
    var streak = Math.max(1, (u && u.streak) || 1);
    var freezes = ensureUserFreezes(u);
    var week = getWeekDaysData(u);

    var existing = document.getElementById('dsDailyMainModal');
    if (existing) existing.remove();

    var weekHtml = week.map(function (w) {
      var icon = '○';
      var cls = 'ds-week-day';
      if (w.status === 'completed') { icon = '✓'; cls += ' ds-day-done'; }
      else if (w.status === 'freeze') { icon = '🧊'; cls += ' ds-day-freeze'; }
      else if (w.isToday) { icon = '•'; cls += ' ds-day-today'; }
      else if (w.status === 'future') { cls += ' ds-day-future'; }
      return '<div class="' + cls + '"><span class="ds-day-lbl">' + w.label + '</span><span class="ds-day-dot">' + icon + '</span></div>';
    }).join('');

    var robotHtml = '';
    try {
      if (window.ITMascot && typeof window.ITMascot.html === 'function') {
        robotHtml = window.ITMascot.html('idle', 'mascot--md');
      }
    } catch (e) { /* noop */ }

    var modal = document.createElement('div');
    modal.id = 'dsDailyMainModal';
    modal.className = 'ds-screen-overlay';
    modal.innerHTML =
      '<div class="ds-screen-card ds-anim-in">' +
        '<div class="ds-screen-badge"><span aria-hidden="true">🔥</span> BUGUNGI MAQSAD</div>' +
        '<h2 class="ds-screen-title">15 daqiqa dars va bilimingizni sinang</h2>' +
        '<div class="ds-mascot-box">' + (robotHtml || '<div class="ds-mascot-fallback">🤖</div>') + '</div>' +
        '<div class="ds-streak-counter">' +
          blueFireSVG(42) +
          '<span class="ds-streak-number ds-blue-text">' + streak + '</span>' +
          '<span class="ds-streak-unit">kunlik streak</span>' +
        '</div>' +
        '<div class="ds-freeze-hint"><span aria-hidden="true">🧊</span> <b>' + freezes + ' ta</b> Streak Freeze mavjud</div>' +
        '<div class="ds-week-row" aria-label="Haftalik streak">' + weekHtml + '</div>' +
        '<div class="ds-screen-actions">' +
          '<button type="button" class="btn btn-primary ds-btn-lg" id="dsStartFirstLessonBtn">🚀 1-darsni boshlash →</button>' +
        '</div>' +
      '</div>';

    document.body.appendChild(modal);

    var btn = modal.querySelector('#dsStartFirstLessonBtn');
    if (btn) {
      btn.addEventListener('click', function () {
        store.settings.onboardingIntroCompleted = true;
        saveFullStore(store);

        modal.classList.add('ds-anim-out');
        setTimeout(function () {
          modal.remove();
          if (options && typeof options.onDone === 'function') options.onDone();
        }, reducedMotion() ? 10 : 320);
      });
    }
  }

  /* 4. STREAK CELEBRATION MODAL (Mobile only, 1.5–2 sec -> Auto Dashboard) */
  function showStreakCelebration(info) {
    if (!isMobile()) return;
    var store = getFullStore();
    var today = dayKey();
    var rec = getDayRecord(store, today);

    // Shu kuni allaqachon celebration ko'rsatilgan bo'lsa qayta chiqmasin
    if (rec.celebrationShown) return;
    rec.celebrationShown = true;
    saveFullStore(store);

    var u = currentUser();
    syncStreakAndFreezes(u);
    var streak = Math.max(1, (u && u.streak) || 1);
    var xpEarned = info.xp || 20;
    var week = getWeekDaysData(u);

    var existing = document.getElementById('dsCelebModal');
    if (existing) existing.remove();

    var weekHtml = week.map(function (w) {
      var icon = '○';
      var cls = 'ds-week-day';
      if (w.status === 'completed' || w.isToday) { icon = '✓'; cls += ' ds-day-done'; }
      else if (w.status === 'freeze') { icon = '🧊'; cls += ' ds-day-freeze'; }
      else if (w.status === 'future') { cls += ' ds-day-future'; }
      return '<div class="' + cls + '"><span class="ds-day-lbl">' + w.label + '</span><span class="ds-day-dot">' + icon + '</span></div>';
    }).join('');

    var robotHtml = '';
    try {
      if (window.ITMascot && typeof window.ITMascot.html === 'function') {
        robotHtml = window.ITMascot.html('success', 'mascot--md');
      }
    } catch (e) { /* noop */ }

    var modal = document.createElement('div');
    modal.id = 'dsCelebModal';
    modal.className = 'ds-screen-overlay ds-celeb-overlay';
    modal.innerHTML =
      '<div class="ds-screen-card ds-celeb-card ds-anim-pop">' +
        '<div class="ds-celeb-halo"></div>' +
        '<div class="ds-mascot-box">' + (robotHtml || '<div class="ds-mascot-fallback">🎉</div>') + '</div>' +
        '<div class="ds-streak-counter">' +
          blueFireSVG(44) +
          '<span class="ds-streak-number ds-blue-text">' + streak + '</span>' +
          '<span class="ds-streak-unit">kunlik streak!</span>' +
        '</div>' +
        '<p class="ds-celeb-sub">Bugungi dars va test bajarildi! ⭐ <b>+' + xpEarned + ' XP</b></p>' +
        '<div class="ds-week-row">' + weekHtml + '</div>' +
        '<div class="ds-celeb-auto-note">Bosh sahifaga o‘tilmoqda…</div>' +
      '</div>';

    document.body.appendChild(modal);

    try {
      if (typeof window.__itConfetti === 'function' && !reducedMotion()) {
        window.__itConfetti();
      }
    } catch (e) { /* noop */ }

    var autoTimer = setTimeout(function () {
      closeCelebration();
    }, reducedMotion() ? 800 : 2000);

    function closeCelebration() {
      if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
      modal.classList.add('ds-anim-out');
      setTimeout(function () {
        modal.remove();
        if (typeof window.__itShowPage === 'function') {
          window.__itShowPage('dashboard');
        }
      }, reducedMotion() ? 10 : 300);
    }

    modal.addEventListener('click', closeCelebration);
  }

  /* ---------- LESSON -> EXISTING TEST BRIDGE ---------- */
  function findMatchingTestForCourse(courseId) {
    var map = {
      html: 'HTML-beginner-1',
      css: 'CSS-beginner-1',
      javascript: 'JavaScript-beginner-1',
      python: 'Python-beginner-1',
      java: 'Java-beginner-1',
      cpp: 'C++-beginner-1',
      csharp: 'C#-beginner-1',
      sql: 'SQL-beginner-1',
      ai: 'AI-beginner-1'
    };
    return map[courseId] || null;
  }

  function openTestForCourse(courseId) {
    var testId = findMatchingTestForCourse(courseId);
    if (testId && typeof window.__itStartQuiz === 'function') {
      try {
        window.__itStartQuiz(testId);
        return true;
      } catch (e) { /* fallback */ }
    }
    if (typeof window.__itShowPage === 'function') {
      window.__itShowPage('tests');
      return true;
    }
    return false;
  }

  /* ============================================================
     HOOKS VA GLOBAL EXPORTS
     ============================================================ */

  // Dars boshlanganda session ochish
  function onLessonOpened(courseId, lessonId) {
    startLearningSession(courseId, lessonId);
  }

  // Dars tugaganda daily record yozish (CELEBRATION CHIQMAYDI!)
  function onLessonCompleted(info) {
    endLearningSession();
    var courseId = info.courseId || (info.course && info.course.id);
    var lessonId = info.lesson && info.lesson.id;
    var xp = info.xp || (info.lesson && info.lesson.xp) || 10;
    recordActivity('lesson', { courseId: courseId, lessonId: lessonId, xp: xp });
  }

  // Mavjud test tugaganda daily record yozish + faqat bugun successful day bo'lsa celebration
  function onTestFinished(info) {
    var rec = recordActivity('test', {
      subject: info.subject,
      testId: info.testId,
      score: info.score,
      xp: info.score
    });

    // FAQAT BUGUNGI SUCCESSFUL DAY BO'LGANDA (lesson + test muvaffaqiyatli yakunlangach)
    if (isMobile() && rec.lessonsCompleted > 0 && rec.testsCompleted > 0 && !rec.celebrationShown) {
      showStreakCelebration({
        xp: rec.xpEarned || info.score,
        subject: info.subject
      });
    }
  }

  window.DailyStreak = {
    isMobile: isMobile,
    dayKey: dayKey,
    daysDiff: daysDiff,
    getFullStore: getFullStore,
    saveFullStore: saveFullStore,
    getDayRecord: getDayRecord,
    getWeekDaysData: getWeekDaysData,
    ensureUserFreezes: ensureUserFreezes,
    syncStreakAndFreezes: syncStreakAndFreezes,
    recordActivity: recordActivity,
    startLearningSession: startLearningSession,
    endLearningSession: endLearningSession,
    showMobileIntro: showMobileIntro,
    showMobilePermission: showMobilePermission,
    showMobileDailyMain: showMobileDailyMain,
    showStreakCelebration: showStreakCelebration,
    openTestForCourse: openTestForCourse,
    onLessonOpened: onLessonOpened,
    onLessonCompleted: onLessonCompleted,
    onTestFinished: onTestFinished
  };
})();

