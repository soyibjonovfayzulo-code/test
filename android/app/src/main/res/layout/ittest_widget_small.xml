<?xml version="1.0" encoding="utf-8"?>
<!-- ITTest SMALL widget (2x2): brand + streak + daily progress -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ittest_widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Header: logo + brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher_round"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_brand"
            android:textColor="@color/it_widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_brand" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_freeze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/it_widget_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="🧊 1"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <!-- Streak: blue flame + N kun -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/it_widget_flame"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_streak_empty"
            android:textColor="@color/it_widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_streak_a11y" />
    </LinearLayout>

    <!-- Daily progress -->
    <TextView
        android:id="@+id/widget_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_progress_empty"
        android:textColor="@color/it_widget_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:contentDescription="@string/widget_progress_a11y" />

    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/ittest_widget_progress"
        android:importantForAccessibility="no" />

    <!-- XP: ⭐ +N XP -->
    <TextView
        android:id="@+id/widget_xp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="⭐ +0 XP"
        android:textColor="@color/it_widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:contentDescription="@string/widget_stat_sub_xp" />
</LinearLayout>
