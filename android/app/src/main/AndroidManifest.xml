<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- Dynamic Launcher Icon Activity Aliases -->
        <activity-alias
            android:name=".OrzuTalimActive"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_active"
            android:roundIcon="@mipmap/ic_launcher_active_round"
            android:label="@string/title_activity_main"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OrzuTalimSleeping"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sleeping"
            android:roundIcon="@mipmap/ic_launcher_sleeping_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OrzuTalimMissing"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_missing"
            android:roundIcon="@mipmap/ic_launcher_missing_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OrzuTalimAngry"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_angry"
            android:roundIcon="@mipmap/ic_launcher_angry_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OrzuTalimWelcome"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_welcome"
            android:roundIcon="@mipmap/ic_launcher_welcome_round"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ITTest SMALL home screen widget -->
        <receiver
            android:name=".widget.ITTestWidgetSmall"
            android:label="@string/widget_label_small"
            android:description="@string/widget_description_small"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ittest_widget_small_info" />
        </receiver>

        <!-- ITTest LARGE home screen widget (asosiy reference design) -->
        <receiver
            android:name=".widget.ITTestWidgetLarge"
            android:label="@string/widget_label_large"
            android:description="@string/widget_description_large"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ittest_widget_large_info" />
        </receiver>

        <!-- ITTest MEDIUM home screen widget -->
        <receiver
            android:name=".widget.ITTestWidgetMedium"
            android:label="@string/widget_label_medium"
            android:description="@string/widget_description_medium"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ittest_widget_medium_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push notification (Android 13+ POST_NOTIFICATIONS) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Haptic feedback / vibration fallback -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>

