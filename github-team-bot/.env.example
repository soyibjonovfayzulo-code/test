# ==============================================
# ORZUTALIM DEV BOT — environment variables
# HECH QANDAY HAQIQIY SECRET BU FAYLGA YOZMANG.
# .env faylini yaratib, qiymatlarni shu yerda
# to'ldiring. .env .gitignore'da.
# ==============================================

# --- Telegram ---
# @BotFather dan olingan bot token
TELEGRAM_BOT_TOKEN=
# Dev guruh chat ID (manfiy raqam, masalan -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# --- GitHub ---
# Private repo uchun PAT (fine-grained, faqat: Contents read, Pull requests read).
# Public repo uchun bo'sh qoldirish mumkin (rate limit past bo'ladi).
GITHUB_TOKEN=
# Repository egasi va nomi
GITHUB_OWNER=
GITHUB_REPO=
# Asosiy branch nomi
GITHUB_DEFAULT_BRANCH=main
# Webhook imzolash secreti (GitHub webhook sozlamasida ham xuddi shu qiymat)
GITHUB_WEBHOOK_SECRET=

# --- Telegram adminlar (vergul bilan ajratilgan telegram user IDlar) ---
# Masalan: BOT_ADMIN_IDS=111111,222222
BOT_ADMIN_IDS=

# --- Bot HTTP server (webhook qabul qilish porti) ---
BOT_PORT=4010

# --- Local Dev Agentlar tokenlari ---
# Format: ahatjon=token1,sardor=token2,shodyona=token3,oyatilo=token4,omadbek=token5
# Tokenlarni generatsiya qilish: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Har token faqat o'sha member agentiga beriladi (agent-setup/<member>.env orqali)
AGENT_TOKENS=

# --- Git repository path (bot shu repoda Git Status/Pull/Push bajaradi) ---
# Bo'sh bo'lsa: botning 2 ta yuqori papkasi (OrzuTalim root) default bo'ladi.
# Windows misol: REPO_PATH=C:\projects\orzutalim
REPO_PATH=

# Reverse proxy orqali ochiq URL (GitHub Webhook Payload URL shu bo'ladi)
# Masalan: https://orzutalim.uz/github-bot/webhook
PUBLIC_WEBHOOK_URL=

# Workflow (CI) success xabarlarini ham yuborish (spam kamaytirish uchun default: false)
# true qilsangiz har muvaffaqiyatli build haqida ham xabar chiqadi.
NOTIFY_WORKFLOW_SUCCESS=false
