# ==============================================
# ORZUTALIM LOCAL DEV AGENT — konfiguratsiya
# BU FAYLNI O'ZINGIZGA MOS TO'LDIRING.
# AGENT_TOKEN ni admin'dan (bot egasi) oling.
# ==============================================

# Member kaliti (faqat: ahatjon, sardor, shodyona, oyatilo, omadbek)
AGENT_NAME=sardor

# Admin'dan olgan tokeningiz (bot .env dagi AGENT_TOKENS ichida)
AGENT_TOKEN=

# Central Bot manzili (admin server manzili)
# Lokal test uchun: http://localhost:4010
BOT_URL=http://localhost:4010

# O'z kompyuteringizdagi OrzuTalim repository yo'li
REPO_PATH=C:\projects\orzutalim

# Sizning allowed branchingiz (admin tomonidan tasdiqlangan)
BRANCH=sardor
